{
    "name": "strata-noble",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "npm@10.8.2",
    "scripts": {
        "build": "cd apps/website && npm run build",
        "dev": "cd apps/website && npm run dev",
        "start": "cd apps/website && npm run start",
        "pre-push-check": "node scripts/pre-push-validation.mjs",
        "validate": "npm run pre-push-check",
        "lint:fix": "cd apps/website && npm run lint:fix",
        "auto-fix": "node scripts/auto-fix-lint.mjs"
    },
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    },
    "dependencies": {
        "pg": "^8.16.3"
    },
    "devDependencies": {
        "chalk": "^5.6.2"
    }
}
