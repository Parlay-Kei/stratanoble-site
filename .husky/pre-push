#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "🚀 PRE-PUSH: UNIT TESTS & VALIDATION"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# Show what's being pushed
echo "📤 Commits to be pushed:"
git log --oneline @{u}.. 2>/dev/null | sed 's/^/   /' || echo "   (Unable to determine commits)"
echo ""

# Run unit tests only (fast, no DB required)
echo "🧪 Running unit tests..."
cd apps/website
npm test -- --testPathIgnorePatterns=integration --passWithNoTests

UNIT_TEST_EXIT=$?

if [ $UNIT_TEST_EXIT -ne 0 ]; then
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "❌ UNIT TESTS FAILED"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  echo "⚠️  Push blocked. Fix unit test failures before pushing."
  echo "   (Integration tests will run in CI)"
  echo ""
  exit 1
fi

cd ../..

# Scan for exposed secrets (non-blocking due to known false positives)
echo ""
echo "🔍 Scanning for exposed secrets..."
node scripts/check-secrets.mjs || true

# Note: Secret scan is non-blocking because we have known false positives:
# - public-config.ts: Public anon key fallback (designed to be public)
# - security-core.test.ts: Test mock JWT
# - deploy scripts: Placeholder examples
# Review warnings above and rotate any real exposed secrets

# Run comprehensive validation
echo ""
echo "🔍 Running pre-push validation..."
npm run agents trigger pre-push

VALIDATION_EXIT=$?

if [ $VALIDATION_EXIT -eq 0 ] && [ $UNIT_TEST_EXIT -eq 0 ]; then
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "✅ PRE-PUSH VALIDATION PASSED"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "🚀 Pushing to remote..."
  echo "   (Integration tests will run in CI)"
  echo ""
else
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "❌ PRE-PUSH VALIDATION FAILED"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  echo "⚠️  Push blocked. Fix issues before deploying to production."
  echo ""
  exit 1
fi
