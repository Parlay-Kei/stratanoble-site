#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Strata Noble Pre-commit Hook
# Runs before every commit to ensure code quality

echo "🚀 Running Strata Noble pre-commit checks..."

# =============================================================================
# DRIFT GUARD: .claude-anx Governance Enforcement
# =============================================================================
# This check runs FIRST to catch forbidden .claude/ files before any other checks.
# Override with: git commit --no-verify -m "DRIFT-OVERRIDE: [justification]"
# =============================================================================

echo "🛡️  Running drift guard..."
if [ -f "./scripts/drift/drift-guard.sh" ]; then
    sh ./scripts/drift/drift-guard.sh || {
        echo "❌ Drift guard blocked commit. See above for details."
        echo "   Override: git commit --no-verify -m \"DRIFT-OVERRIDE: [reason]\""
        exit 1
    }
else
    echo "⚠️  Drift guard script not found, skipping..."
fi

# Run pre-push validation (includes type check, lint, tests)
echo "📝 Running validation checks..."
npm run validate || {
  echo "❌ Validation failed. Please fix errors before committing."
  exit 1
}

# Check contracts
echo "📋 Checking contracts..."
npm run contract:check || {
  echo "⚠️  Contract check found issues. Review before committing."
}

# Check brand consistency
echo "🎨 Checking brand consistency..."
npm run brand:check || {
  echo "⚠️  Brand consistency issues found. Review before committing."
}

echo "✅ All pre-commit checks passed!"
