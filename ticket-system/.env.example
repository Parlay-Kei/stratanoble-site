# Environment Configuration for Client Ticket System

# Notion Configuration
NOTION_TOKEN=secret_your_notion_integration_token_here
NOTION_SUPPORT_DESK_PAGE_ID=your_support_desk_page_id_here
NOTION_DATABASE_ID=your_database_id_here_after_creation

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-level-token-here
SLACK_SIGNING_SECRET=your_signing_secret_here

# Slack Channel IDs
SLACK_SUPPORT_CHANNEL_ID=C0123456789
SLACK_TRIAGE_CHANNEL_ID=C9876543210

# Automation Configuration
DAILY_DIGEST_CRON=0 9 * * 1-5
WEEKLY_SUMMARY_CRON=0 16 * * 5
TIMEZONE=America/Los_Angeles

# Deployment (optional)
PORT=3000
NODE_ENV=production
