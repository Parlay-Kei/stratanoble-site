{
    "name": "client-ticket-system",
    "version": "1.0.0",
    "description": "Notion + Slack Client Ticket System Automation",
    "main": "automation/src/index.js",
    "type": "module",
    "scripts": {
        "dev": "node automation/src/index.js",
        "setup:notion": "node automation/scripts/setup-notion-database.js",
        "setup:complete": "node automation/scripts/complete-setup.js",
        "finish:setup": "node automation/scripts/finish-setup.js",
        "post:rules": "node automation/scripts/post-channel-rules.js",
        "test:digest": "node automation/scripts/test-daily-digest.js",
