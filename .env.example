# Application
NEXT_PUBLIC_BASE_URL=http://localhost:8080
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/stratanoble

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# AWS SES Email
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
SES_FROM_EMAIL=notifications@stratanoble.com
NOTIFICATION_EMAIL=steve@stratanoble.com
ADMIN_EMAIL=admin@stratanoble.com

# Analytics & Monitoring
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com

# Error Monitoring - Sentry
SENTRY_DSN=your_sentry_dsn_url
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_url
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_SUPPRESS_GLOBAL_ERROR_HANDLER_FILE_WARNING=1

# QStash (Optional - for background jobs)
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=your_qstash_token

# Upstash Redis (Required for rate limiting)
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# ACHIEVERY Integration
NEXT_PUBLIC_ACHIEVERY_URL=https://app.achievery.com

# NextAuth Configuration (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=https://yourdomain.com

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# SMTP Email (Optional - for magic link authentication)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# Vault Encryption Key (openssl rand -hex 32)
VAULT_ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# Supabase Admin Automation
# Required for autonomous security management
SUPABASE_PROJECT_REF=bvneqoevtwodyfqglpzi
SUPABASE_ACCESS_TOKEN=              # Get from: https://supabase.com/dashboard/account/tokens
SUPABASE_DB_URL=                    # Get from: Project Settings > Database > Connection String (URI)
AUTO_APPLY_FIXES=true               # Set to false to disable auto-apply in CI/CD
MAX_RETRIES=3                       # Number of retry attempts for failed operations
NOTIFY_ON_FAILURE=true              # Send notifications on audit failures

# Slack Notifications (Optional)
SLACK_WEBHOOK_URL=                  # Get from: Slack App > Incoming Webhooks

