# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Environment
NODE_ENV=development

# KILL SWITCH - Set to 'true' to disable ALL contract generation
# Use in emergencies or when investigating issues
# PARALEGAL_KILL_SWITCH=false

# Security Notes:
# - NEVER commit .env to git
# - NEVER share SUPABASE_SERVICE_ROLE_KEY (it bypasses RLS)
# - Rotate keys if they've been exposed in logs, chat, or screenshots
# - Use environment-specific keys for dev/staging/prod
