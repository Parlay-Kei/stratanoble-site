{
  "framework": "nextjs",
  "buildCommand": "cd apps/website && npm install && npm run build",
  "devCommand": "cd apps/website && npm run dev",
  "installCommand": "npm ci",
  "outputDirectory": "apps/website/.next",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/achievery",
      "destination": "/achievery-preview",
      "permanent": false
    }
  ]
} 