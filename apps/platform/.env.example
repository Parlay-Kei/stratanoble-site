# Inherits from parent monorepo .env
# Platform-specific environment variables

# Database (uses existing Strata Noble Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication (integrates with existing system)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001

# Stripe (uses existing Strata Noble integration)
# Already configured in parent monorepo

# Platform-specific features
ACHIEVERY_API_BASE_URL=http://localhost:3001/api

# OpenAI API for Reframe Engine (ACHIEVERY's core feature)
# The Reframe Engine transforms ordinary activities into professional, business-oriented language
# Uses GPT-4o-mini for cost-effective, high-quality text transformation
# If not provided, falls back to rule-based reframing (still functional but less sophisticated)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here