{
  "framework": "nextjs",
  "installCommand": "npm install --prefix ../../packages/utils && npm install --prefix ../../packages/ui && npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/achievery",
      "destination": "/achievery-preview",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/cron/execute-calls",
      "schedule": "*/5 * * * *"
    }
  ]
}
