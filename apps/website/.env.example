# Website Environment Variables Example
# Copy this file to .env.local and update with your values

# ACHIEVERY Platform URL
# For development: http://localhost:3001
# For production: https://app.achievery.com
NEXT_PUBLIC_ACHIEVERY_URL=http://localhost:3001

# Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe Configuration (Live Keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Platform Tier Price IDs
NEXT_PUBLIC_STRIPE_BUILDER_PRICE_ID=your_builder_price_id
NEXT_PUBLIC_STRIPE_PROSPERITY_PRICE_ID=your_prosperity_price_id

# SendGrid Configuration (for email notifications)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=contact@stratanoble.com

# OpenAI Configuration (for idea validation API)
OPENAI_API_KEY=your_openai_api_key
# AWS SES (Email)\nAWS_ACCESS_KEY_ID=your_aws_access_key_id\nAWS_SECRET_ACCESS_KEY=your_aws_secret_access_key\nAWS_REGION=us-east-1\nSES_FROM_EMAIL=contact@stratanoble.com\nADMIN_EMAIL=admin@stratanoble.com\n
