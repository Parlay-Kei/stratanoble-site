# Website Environment Variables Example
# Copy this file to .env.local and update with your values

# Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_REVAMP_ENABLED=false

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe Configuration (Live Keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Platform Tier Price IDs
NEXT_PUBLIC_STRIPE_BUILDER_PRICE_ID=your_builder_price_id
NEXT_PUBLIC_STRIPE_PROSPERITY_PRICE_ID=your_prosperity_price_id

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_generated_secret

# Optional dev-only credentials login
NEXTAUTH_DEV_LOGIN=true
DEV_LOGIN_PASSWORD=dev

# Auth DB adapter toggle (set to false to use JWT instead of database sessions)
AUTH_USE_PRISMA=false

# OAuth Providers (all optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
AZURE_AD_CLIENT_ID=your_azure_ad_client_id
AZURE_AD_CLIENT_SECRET=your_azure_ad_client_secret
AZURE_AD_TENANT_ID=your_azure_ad_tenant_id

# Email provider (AWS SES)
SES_FROM_EMAIL=no-reply@your-domain.com
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# ACHIEVERY Platform URL
NEXT_PUBLIC_ACHIEVERY_URL=http://localhost:3001

# ============================================
# COLD CALLING SYSTEM (DSLV)
# ============================================

# Twilio Voice Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER_PRIMARY=+1XXXXXXXXXX

# OpenAI API (for conversation AI)
OPENAI_API_KEY=sk-your_openai_api_key

# Cron Job Security (generate a random secret)
# Example: openssl rand -base64 32
CRON_SECRET=your_random_secret_string

# ============================================
# LEAD INTAKE INFRASTRUCTURE
# ============================================

# Upstash Redis (Required for rate limiting - create free at upstash.com)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Prisma/PostgreSQL Database (for LeadIntake storage)
DATABASE_URL=postgresql://user:password@localhost:5432/stratanoble

# Admin notification email
NOTIFICATION_EMAIL=admin@your-domain.com
