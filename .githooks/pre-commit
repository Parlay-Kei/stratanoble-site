#!/bin/bash
# Strata Noble Pre-commit Hook
# Runs quick checks before allowing commit

echo "🔍 Running pre-commit checks for Strata Noble..."

# =============================================================================
# DRIFT GUARD: .claude-anx Governance Enforcement
# =============================================================================
echo "🛡️  Running drift guard..."
if [ -f "./scripts/drift/drift-guard.sh" ]; then
    bash ./scripts/drift/drift-guard.sh
    if [ $? -ne 0 ]; then
        echo "❌ Drift guard blocked commit. See above for details."
        echo "   Override: git commit --no-verify -m \"DRIFT-OVERRIDE: [reason]\""
        exit 1
    fi
else
    echo "⚠️  Drift guard script not found, skipping..."
fi

cd apps/platform

# Type check
echo "📝 Type checking..."
npm run type-check
if [ $? -ne 0 ]; then
    echo "❌ Type check failed. Please fix TypeScript errors before committing."
    exit 1
fi

# Lint (continue with warnings)
echo "🧹 Linting..."
npm run lint || true

# Quick unit tests
echo "🧪 Running tests..."
npm run test:run
if [ $? -ne 0 ]; then
    echo "❌ Tests failed. Please fix failing tests before committing."
    exit 1
fi

cd ../..

# Run validation checks
echo "✅ Running validation..."
npm run validate || true

echo "✅ All pre-commit checks passed!"
exit 0
