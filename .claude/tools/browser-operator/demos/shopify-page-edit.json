{
  "platform": "shopify",
  "settings": {
    "headless": false,
    "slowMo": 500,
    "debug": true
  },
  "operation": {
    "action": "edit",
    "credentials": {
      "store": "demo-store",
      "email": "admin@demo-store.com",
      "password": "secure_password_here",
      "mfaCode": null
    },
    "target": {
      "type": "page",
      "name": "About Us",
      "pageHandle": "about-us",
      "store": "demo-store"
    },
    "changes": [
      {
        "field": "input[name='page[title]']",
        "value": "About Our Company - Updated",
        "action": "fill"
      },
      {
        "field": "div[contenteditable='true']",
        "value": "<h2>Welcome to Our Store</h2><p>We are dedicated to providing excellent products and exceptional customer service. Our team works tirelessly to ensure your satisfaction.</p><p><strong>Updated on:</strong> " + new Date().toLocaleDateString() + "</p>",
        "action": "richtext"
      },
      {
        "field": "input[name='page[handle]']",
        "value": "about-us",
        "action": "fill"
      },
      {
        "field": "textarea[name='page[meta_description]']",
        "value": "Learn about our company's mission, values, and commitment to excellence in serving our customers.",
        "action": "fill"
      }
    ]
  }
}