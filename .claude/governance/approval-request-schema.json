{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Approval Request Artifact Schema v1.0",
  "description": "Structure for approval requests that block pipeline execution",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^APR-[A-Z0-9]{8}-[A-Z0-9]{4}$",
      "description": "Unique approval request identifier"
    },
    "ticketId": {
      "type": "string",
      "pattern": "^OCS-[A-Z]+-\\d{4}$",
      "description": "Associated OCS ticket"
    },
    "sessionId": {
      "type": "string",
      "description": "Pipeline session being blocked"
    },
    "requestType": {
      "type": "string",
      "enum": [
        "financial",
        "deployment",
        "data_deletion",
        "security_change",
        "production_access",
        "contract_approval",
        "high_risk_operation",
        "manual_verification"
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "description": "Risk severity level"
    },
    "requester": {
      "type": "object",
      "properties": {
        "agentId": { "type": "string" },
        "skillName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["agentId", "timestamp"]
    },
    "context": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "description": "Operation being attempted"
        },
        "target": {
          "type": "string",
          "description": "Target of the operation"
        },
        "reason": {
          "type": "string",
          "description": "Why approval is needed"
        },
        "risks": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Identified risks"
        },
        "impact": {
          "type": "object",
          "properties": {
            "scope": { "type": "string", "enum": ["local", "service", "system", "global"] },
            "users": { "type": "integer" },
            "services": { "type": "array", "items": { "type": "string" } },
            "estimatedDuration": { "type": "string" }
          }
        },
        "rollbackPlan": {
          "type": "string",
          "description": "How to rollback if needed"
        }
      },
      "required": ["operation", "reason"]
    },
    "approvalRequirements": {
      "type": "object",
      "properties": {
        "requiredApprovers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string" },
              "agentId": { "type": "string" },
              "optional": { "type": "boolean", "default": false }
            }
          }
        },
        "minimumApprovals": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "When this request expires"
        },
        "autoApproveAfter": {
          "type": "integer",
          "description": "Auto-approve after N seconds (if configured)"
        }
      },
      "required": ["requiredApprovers", "minimumApprovals"]
    },
    "checkpointState": {
      "type": "object",
      "description": "State to resume from",
      "properties": {
        "stage": { "type": "string" },
        "step": { "type": "integer" },
        "data": { "type": "object" },
        "completed": { "type": "array", "items": { "type": "string" } },
        "remaining": { "type": "array", "items": { "type": "string" } }
      }
    },
    "status": {
      "type": "string",
      "enum": ["pending", "approved", "rejected", "expired", "bypassed"],
      "default": "pending"
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "approverId": { "type": "string" },
          "role": { "type": "string" },
          "decision": { "type": "string", "enum": ["approve", "reject"] },
          "token": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "comments": { "type": "string" }
        },
        "required": ["approverId", "decision", "token", "timestamp"]
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "requestId",
    "ticketId",
    "requestType",
    "severity",
    "requester",
    "context",
    "approvalRequirements",
    "status",
    "createdAt"
  ]
}