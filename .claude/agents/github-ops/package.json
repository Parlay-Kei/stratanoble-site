{
  "name": "@dslv/github-ops-agent",
  "version": "1.0.0",
  "description": "GitHub Operations Agent - Manages workflows, actions, secrets, and repository operations",
  "type": "module",
  "main": "src/agent.js",
  "bin": {
    "github-ops": "./src/cli/index.js"
  },
  "scripts": {
    "start": "node src/mcp/server.js",
    "cli": "node src/cli/index.js",
    "test": "node --test src/**/*.test.js",
    "test-token": "node test-token.js",
    "diagnose": "node src/cli/index.js diagnose",
    "workflows:list": "node src/cli/index.js workflows list",
    "workflows:status": "node src/cli/index.js workflows status",
    "secrets:audit": "node src/cli/index.js secrets audit",
    "actions:failures": "node src/cli/index.js actions failures"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@octokit/rest": "^21.0.0",
    "@octokit/auth-token": "^5.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "ora": "^8.0.1",
    "table": "^6.8.2"
  },
  "devDependencies": {
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "github",
    "actions",
    "workflows",
    "mcp",
    "automation",
    "devops"
  ]
}
