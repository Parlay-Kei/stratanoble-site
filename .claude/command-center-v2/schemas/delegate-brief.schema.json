{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Delegate Brief",
  "description": "Canonical input format for Command Center delegation",
  "type": "object",
  "required": ["title", "type", "target", "why", "definition_of_done"],
  "properties": {
    "title": {
      "type": "string",
      "description": "Brief title - what are we doing"
    },
    "type": {
      "type": "string",
      "enum": ["project", "feature", "process"],
      "description": "Type of work"
    },
    "target": {
      "type": "string",
      "description": "Target repo/system"
    },
    "why": {
      "type": "string",
      "description": "Why this matters"
    },
    "definition_of_done": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Success criteria"
    },
    "scope_included": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What's in scope"
    },
    "scope_excluded": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What's explicitly out of scope"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Hard constraints"
    },
    "risk_tolerance": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "default": "medium",
      "description": "Acceptable risk level"
    },
    "approval_thresholds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string"
          },
          "requires": {
            "type": "string"
          }
        },
        "required": ["condition", "requires"]
      },
      "description": "When to pause for approval"
    },
    "deadline": {
      "type": "string",
      "format": "date-time",
      "description": "Optional deadline"
    }
  }
}