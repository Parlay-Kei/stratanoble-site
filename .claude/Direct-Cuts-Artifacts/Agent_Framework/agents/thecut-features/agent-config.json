{
  "name": "TheCut Features Agent",
  "version": "1.0.0",
  "description": "Implements all 5 theCut-inspired features with Direct Cuts improvements",
  "trigger": "thecut",
  "capabilities": [
    "database_migrations",
    "typescript_react_components",
    "service_layer_implementation",
    "unit_economics_tracking",
    "flutter_mobile_sync"
  ],
  "config": {
    "unit_economics": {
      "commission_rate": 0.15,
