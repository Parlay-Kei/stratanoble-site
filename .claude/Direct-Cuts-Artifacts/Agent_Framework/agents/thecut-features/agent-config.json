        "priority": "P1",
        "days_estimate": 2,
        "components": [
          "ServiceCard",
          "ServiceList",
          "ServiceSelector",
          "SelectedServicesBar"
        ]
      },
      {
        "id": "client_management",
        "priority": "P1",
        "days_estimate": 3,
        "components": [
          "ClientListHeader",
          "ClientList",
          "ClientRow",
          "AlphabetIndex"
