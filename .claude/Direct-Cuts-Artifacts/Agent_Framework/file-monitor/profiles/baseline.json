{
  "$schema": "./profile-schema.json",
  "profile": {
    "name": "baseline",
    "version": "1.0.0",
    "description": "Shared baseline profile - inherited by all project-specific profiles",
    "inherits": null
  },

  "settings": {
    "debounce": {
      "windowMs": 2000,
      "maxWaitMs": 10000,
      "coalesceByDirectory": true,
      "coalesceByExtension": true
    },
    "queue": {
      "maxConcurrent": 2,
      "retryAttempts": 2,
      "retryDelayMs": 5000,
      "staleJobTimeoutMs": 300000
    },
    "outcomes": {
      "requireArtifact": true,
      "artifactDir": ".anx/artifacts",
      "logsDir": ".anx/logs",
      "rejectOnMissingOutcome": true
    },
    "gates": {
      "enabled": true,
      "autoApprove": ["D"],
      "requireApproval": ["A", "B", "C"]
    }
  },

  "ignoredPatterns": [
    "**/node_modules/**",
    "**/.git/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/coverage/**",
    "**/*.log",
    "**/.anx/**",
    "**/state.db*"
  ],

  "riskZones": [
    {
      "id": "ipc-boundary",
      "pattern": "**/preload/**",
      "gate": "B",
      "reason": "IPC boundary changes affect security model"
    },
    {
      "id": "filesystem-ops",
      "patterns": ["**/fs/**", "**/file*/**", "**/scan*/**"],
      "gate": "B",
      "reason": "Filesystem operations require path traversal review"
    },
    {
      "id": "database-queries",
      "patterns": ["**/*.sql", "**/db/**", "**/database/**", "**/migrations/**"],
      "gate": "C",
      "reason": "Database changes require migration review"
    },
    {
      "id": "auth-handling",
      "patterns": ["**/auth/**", "**/login/**", "**/session/**"],
      "gate": "A",
      "reason": "Authentication changes require full security review"
    },
    {
      "id": "secrets-exposure",
      "patterns": ["**/.env*", "**/secrets/**", "**/credentials/**"],
      "gate": "A",
      "reason": "Secrets exposure requires immediate review"
    }
  ],

  "outcomes": {
    "valid": [
      "pr_created",
      "test_report_generated",
      "spec_updated",
      "migration_created",
      "security_finding_created",
      "build_artifact_produced",
      "lint_report_generated",
      "no_issues_found"
    ],
    "artifacts": {
      "test_report": "{logsDir}/test_report_{timestamp}.md",
      "security_scan": "{logsDir}/security_scan_{timestamp}.md",
      "lint_report": "{logsDir}/lint_report_{timestamp}.md",
      "build_log": "{logsDir}/build_{timestamp}.log",
      "agent_run": "{logsDir}/agent_runs/run_{jobId}.md"
    }
  },

  "rules": [
    {
      "id": "baseline-security-secrets",
      "name": "Secret File Detection",
      "pattern": "**/*.{env,key,pem,secret,credentials}",
      "events": ["add", "change"],
      "trigger": "security",
      "priority": "critical",
      "debounceMs": 500,
      "gate": "A",
      "outcomeRequired": "security_finding_created",
      "description": "Immediate security scan on sensitive file changes"
    },
    {
      "id": "baseline-security-hardcoded",
      "name": "Hardcoded Secret Detection",
      "pattern": "**/*.{ts,tsx,js,jsx,mjs,cjs}",
      "events": ["add", "change"],
      "trigger": "security",
      "priority": "high",
      "debounceMs": 5000,
      "conditions": {
        "contentMatch": "(password|secret|api[_-]?key|token|credential|private[_-]?key)\\s*[:=]\\s*['\"`][^'\"`]{8,}",
        "caseSensitive": false
      },
      "outcomeRequired": "security_finding_created",
      "description": "Scan source files for hardcoded secrets"
    },
    {
      "id": "baseline-config-validation",
      "name": "Configuration Validation",
      "pattern": "*.{json,yaml,yml,toml}",
      "events": ["add", "change"],
      "trigger": "admin",
      "priority": "high",
      "debounceMs": 2000,
      "outcomeRequired": "lint_report_generated",
      "description": "Validate root configuration files"
    },
    {
      "id": "baseline-docs-structure",
      "name": "Documentation Structure",
      "pattern": "docs/**/*.md",
      "events": ["add", "change", "unlink"],
      "trigger": "docs",
      "priority": "normal",
      "debounceMs": 3000,
      "outcomeRequired": "lint_report_generated",
      "description": "Validate documentation structure and links"
    },
    {
      "id": "baseline-docs-staleness",
      "name": "Stale Documentation Detection",
      "pattern": "docs/**/*.md",
      "events": ["scan"],
      "trigger": "docs",
      "priority": "low",
      "conditions": {
        "staleDays": 30
      },
      "outcomeRequired": "spec_updated",
      "description": "Flag documentation not updated in 30+ days"
    }
  ],

  "agents": {
    "security": {
      "command": "node",
      "args": ["agents/security.js"],
      "timeout": 60000,
      "retries": 2,
      "outcomeTypes": ["security_finding_created", "no_issues_found"]
    },
    "docs": {
      "command": "node",
      "args": ["agents/docs.js"],
      "timeout": 30000,
      "retries": 1,
      "outcomeTypes": ["lint_report_generated", "spec_updated"]
    },
    "admin": {
      "command": "node",
      "args": ["agents/admin.js"],
      "timeout": 30000,
      "retries": 1,
      "outcomeTypes": ["lint_report_generated", "migration_created"]
    },
    "codebase": {
      "command": "node",
      "args": ["agents/codebase.js"],
      "timeout": 45000,
      "retries": 1,
      "outcomeTypes": ["lint_report_generated", "test_report_generated"]
    }
  },

  "scanning": {
    "enabled": true,
    "intervalMinutes": 60,
    "onStartup": true,
    "batchSize": 50
  },

  "notifications": {
    "enabled": true,
    "console": true,
    "logFile": "monitor.log",
    "webhook": null,
    "onGateRequired": true,
    "onCriticalFinding": true
  }
}
