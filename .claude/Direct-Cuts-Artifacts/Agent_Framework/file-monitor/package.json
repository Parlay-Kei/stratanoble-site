{
  "name": "file-monitor",
  "version": "1.0.0",
  "description": "Local file monitoring agent with chokidar, event bus, and integrated Claude agents",
  "main": "monitor.js",
  "type": "module",
  "scripts": {
    "start": "node monitor.js",
    "start:daemon": "pm2 start ecosystem.config.cjs",
    "stop": "pm2 stop file-monitor",
    "logs": "pm2 logs file-monitor",
    "status": "pm2 status",
    "test": "node --test tests/"
  },
  "dependencies": {
    "better-sqlite3": "^11.6.0",
    "chalk": "^5.3.0",
    "chokidar": "^4.0.3",
    "glob": "^11.0.0",
    "minimatch": "^10.0.1"
  },
  "devDependencies": {
    "pm2": "^5.4.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
