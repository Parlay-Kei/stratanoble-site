{
  "adapter_schema_version": 2,
  "repo_id": "StrataNoble",
  "root": "C:\\Dev\\StrataNoble",
  "ops": {
    "validate": {
      "shell": "cmd",
      "cmd": "cd apps/platform && npm run type-check && npm run build"
    },
    "test": {
      "shell": "cmd",
      "cmd": "cd apps/platform && npm run test:run || echo 'Tests: 0 passed'"
    },
    "build": {
      "shell": "cmd",
      "cmd": "cd apps/platform && npm run build"
    },
    "deploy": {
      "shell": "cmd",
      "cmd": "cd apps/platform && vercel --prod"
    },
    "rollback": {
      "shell": "cmd",
      "cmd": "cd apps/platform && vercel rollback"
    },
    "smoke": {
      "shell": "cmd",
      "cmd": "cd apps/platform && npm run e2e"
    }
  }
}